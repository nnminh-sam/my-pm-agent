# Accounts: signs the 2-hour session JWTs (web cookie or `Authorization: Bearer <jwt>`).
# At least 32 characters (a shorter one locks the app). Generate one with: openssl rand -hex 32
# Leave unset locally for no auth; deployments stay locked until it's set. Changing it logs everyone out.
JWT_SECRET=

# Sign-up: the first account can always be created; after that only these emails may sign up
# (comma-separated, case-insensitive). Leave empty to close sign-up.
# PM_SIGNUP_EMAILS=me@example.com,other@example.com

# Agents authenticate to /api/mcp with API keys: `npm run auth:create-key -- --label laptop`, then
# `Authorization: Bearer <key>` (see README "Agent authentication").
# Optional, legacy: a shared agent bearer secret that also works as `Authorization: Bearer <PM_SECRET>`.
# Only used when JWT_SECRET is set. Generate one with: openssl rand -hex 32
# PM_SECRET=

# Optional: timezone used when settings.yaml doesn't set one (IANA name).
PM_TIMEZONE=Asia/Ho_Chi_Minh

# Storage: Postgres when DATABASE_URL is set, otherwise markdown files in ./data (or PM_DATA_DIR).
# PM_STORAGE overrides the choice. Deployments on Vercel need Postgres.
# PM_STORAGE=postgres|fs
# PM_DATA_DIR=./data

# Neon Postgres. Locally use your own dev branch, never production, so local work can't touch prod data.
# Pooled: app queries. Unpooled: npm run db:migrate / db:import / db:export.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# NEON_BRANCH=development

# Optional: also run the repository tests against real Neon. The suite TRUNCATES this database.
# TEST_DATABASE_URL=
